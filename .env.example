# 自托管运行参数 —— 复制成 .env 由 scripts/db-init.sh 完成（它会顺手生成 JWT_SECRET 与库密码），
# 手工填的话至少把下面四项改对，缺任一项服务直接拒绝启动（startup_misconfigured）。
#
# .env 同时被三处读取：docker compose（含 APP_* 两个端口变量）、src/server.js、
# 以及测试在没给 DB_* 时的兜底 —— 所以它只放「连哪个库」，测试库另写 .env.test。

# ---- 数据库（共享容器 ../mysql-server；容器内主机名固定是 mysql）----
# 宿主机上直接跑的脚本（npm test、scripts/d1-to-mysql.mjs）解析不到 `mysql` 这个名字，
# 会报 getaddrinfo ENOTFOUND mysql —— 同一个实例在宿主机上是 127.0.0.1:3306，
# d1-import.sh 已按这个改写默认值，测试则另有 .env.test。
DB_HOST=mysql
DB_PORT=3306
DB_NAME=notify_hub
DB_USER=notify_hub
DB_PASSWORD=

# ---- 登录 token 的 HMAC 签名密钥，至少 32 字符 ----
# 换掉它 = 所有端（安卓 + Web 控制台）的旧 token 全部失效，需要重新登录一次。
# 迁出 Cloudflare 时无法从 Worker 里读回原来那份（CF 只给 secret 名字不给值），所以只能新签一份。
JWT_SECRET=

# ---- 只在通过 ../gw 网关（有 X-Forwarded-Proto）对外服务时置 1 ----
# 它决定回给 QQ 控制台的回调地址写 http 还是 https：置 0 时公网域名下会给出 http 的回调地址。
TRUST_PROXY=0

# ---- 可选覆盖：默认值已写死在 worker/src/server.js 里，正常部署不用管 ----
# JOBS_TICK_DISABLED=1      # 只跑 HTTP、不装定时器。迁移期用它顶住双推（云上 Cron Trigger
#                           # 还在时本机接单 = 同一条提醒发两遍）；Worker 已下线，现在只在
#                           # 「想让容器只当接口、暂时不接单」时才用，见 README「切流量」
# APP_BIND_ADDR=127.0.0.1   # compose 发布到宿主机的端口绑定地址（只有 compose 读它）
# APP_PORT=8788             # 宿主机端口（8787 已被 writing-assistant 占）
# PORT=8787                 # 应用监听端口；改它要同步改 compose 与 healthcheck
# HOST=0.0.0.0              # 应用绑定网卡；容器里保持 0.0.0.0，本机直跑才可换成 127.0.0.1
# STATIC_DIR=               # 静态控制台目录，默认 ../pages
