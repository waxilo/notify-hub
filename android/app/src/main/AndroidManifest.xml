<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 强力震动：普通权限，无需运行时申请 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 锁屏全屏告警页：低于 IMPORTANCE_HIGH 的渠道上 FSI 完全不生效；
         Android 14 起非闹钟/通话类应用需检测 canUseFullScreenIntent()（设置页已做引导） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".CrashApp"
        android:allowBackup="true"
        android:label="Notify Hub"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotifyHub">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.KeysActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.JobsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false" />

        <!-- 强力震动的锁屏告警页（由通知 fullScreenIntent 拉起）：
             singleInstance  连收多条不叠页面
             excludeFromRecents + finishAndRemoveTask()  不在最近任务留僵尸条目
             showWhenLocked / turnScreenOn  锁屏下盖在锁屏之上并点亮屏幕 -->
        <activity
            android:name=".ui.AlarmActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".data.PushService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
