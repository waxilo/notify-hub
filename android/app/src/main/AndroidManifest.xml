<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 强力震动：普通权限，无需运行时申请 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 点亮屏幕：悬浮窗告警页的 FLAG_TURN_SCREEN_ON 对非 Activity 窗口支持不一，
         用带 ACQUIRE_CAUSES_WAKEUP 的唤醒锁兜底（普通权限） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 锁屏全屏告警页：低于 IMPORTANCE_HIGH 的渠道上 FSI 完全不生效；
         Android 14 起非闹钟/通话类应用需检测 canUseFullScreenIntent()（设置页已做引导） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 显示在其他应用上层（悬浮窗）：这是 Android 10+ 「后台启动 Activity 限制」的**硬豁免**。
         系统闹钟等预装应用天然在白名单里，第三方应用拿不到，于是国产 ROM 上的表现就是
         「闹钟能全屏、自己的应用只剩横幅」。拿到本权限后，PushService 可以自己把告警页
         拉到最前并覆盖锁屏，不再依赖 ROM 是否放行 FSI。属特殊权限，需用户在系统设置里手动开启。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".CrashApp"
        android:allowBackup="true"
        android:label="Notify Hub"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotifyHub">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.KeysActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.JobsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false" />

        <!-- 强力震动的锁屏告警页（由通知 fullScreenIntent 拉起）：
             singleInstance  连收多条不叠页面
             excludeFromRecents + finishAndRemoveTask()  不在最近任务留僵尸条目
             showWhenLocked / turnScreenOn  锁屏下盖在锁屏之上并点亮屏幕 -->
        <activity
            android:name=".ui.AlarmActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".data.PushService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
