<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 顶栏 -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:background="@drawable/bg_brand_dot"
            android:layout_width="16dp"
            android:layout_height="16dp" />

        <TextView
            android:text="设置"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/text_main"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 卡片：提醒权限（强力震动的锁屏全屏依赖全屏通知权限） -->
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="提醒权限"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvNotifStatus"
                    android:text="通知权限：检查中…"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvFsiStatus"
                    android:text="全屏通知：检查中…"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnFsiSetting"
                    android:text="去开启全屏通知"
                    android:visibility="gone"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- 悬浮窗权限：Android 10+ 后台启动 Activity 的硬豁免。
                     系统闹钟等预装应用天然在白名单里，第三方应用没有 —— 这是「闹钟能全屏、
                     我们只剩横幅」的直接原因，也是本页最该开的一项。 -->
                <TextView
                    android:id="@+id/tvOverlayStatus"
                    android:text="悬浮窗权限：检查中…"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnOverlaySetting"
                    android:text="去开启悬浮窗权限"
                    android:visibility="gone"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- 推送渠道重要性：FSI 的硬门槛，且一旦被用户调低 App 再也改不回来 -->
                <TextView
                    android:id="@+id/tvChannelStatus"
                    android:text="推送渠道：检查中…"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnChannelSetting"
                    android:text="去检查推送渠道设置"
                    android:visibility="gone"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="全屏告警页走两条并行通道，任一条通即可：① 系统全屏通知（上面三项状态）；② 悬浮窗权限 —— Android 10 起，后台启动界面受系统限制，系统闹钟等预装应用在白名单里、第三方应用没有，这是「闹钟能全屏而本应用只剩横幅」的直接原因；开启悬浮窗后本应用可自行把告警页拉到锁屏之上，不再受该限制。\n\n若两项都已开启仍只有横幅，请再到系统「应用信息」里允许「后台弹出界面」（小米/华为等机型的独立开关，默认关闭，且会同时废掉上面两条通道），并确认设备处于息屏或锁屏状态：亮屏使用中时系统一律只给横幅，此时点横幅即可进入告警页。"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 卡片：版本与更新 -->
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="版本与更新"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/tvVersion"
                    android:text="当前版本：检查中…"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <Button
                    android:id="@+id/btnCheckUpdate"
                    android:text="检测更新"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/tvUpdateMsg"
                    android:textSize="13sp"
                    android:textColor="@color/ok_text"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 卡片：修改密码 -->
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="修改密码"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <EditText
                    android:id="@+id/etOld"
                    android:hint="原密码"
                    android:inputType="textPassword"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <EditText
                    android:id="@+id/etNew"
                    android:hint="新密码（至少 6 位）"
                    android:inputType="textPassword"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <Button
                    android:id="@+id/btnChangePw"
                    android:text="修改密码"
                    android:textColor="@color/card"
                    android:background="@drawable/bg_btn_primary"
                    android:layout_marginTop="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/tvMsg"
                    android:textSize="13sp"
                    android:textColor="@color/danger"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 卡片：账号 -->
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="账号"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnLogout"
                    android:text="退出登录"
                    android:textColor="@color/danger"
                    android:background="@drawable/bg_btn"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvLogoutMsg"
                    android:textSize="13sp"
                    android:textColor="@color/danger"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <Space android:layout_width="match_parent" android:layout_height="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- 底部页签 -->
    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
