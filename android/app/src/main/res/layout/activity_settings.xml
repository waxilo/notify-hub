<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 顶栏 -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:background="@drawable/bg_brand_dot"
            android:layout_width="16dp"
            android:layout_height="16dp" />

        <TextView
            android:text="设置"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/text_main"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 卡片：提醒权限（强力震动依赖通知权限与推送渠道） -->
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="提醒权限"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvNotifStatus"
                    android:text="通知权限：检查中…"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <!-- 推送渠道重要性：横幅与震动的门槛，且一旦被用户调低 App 再也改不回来 -->
                <TextView
                    android:id="@+id/tvChannelStatus"
                    android:text="推送渠道：检查中…"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnChannelSetting"
                    android:text="去检查推送渠道设置"
                    android:visibility="gone"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="强力提醒 = 无声横幅 + 持续震动（最长 30 秒）。点击横幅、滑掉通知都会立即停止震动。\n\n震动由后台连接直接驱动，与是否锁屏、是否静音、是否处于勿扰无关；但需要上面两项都正常：通知权限被关时不会震动，「推送渠道」被关闭或调低时横幅会消失。\n\n若长时间收不到提醒，请再到系统「应用信息」里允许后台运行（部分国产机型默认限制后台，会断开与服务器的连接）。"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 卡片：版本与更新 -->
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="版本与更新"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/tvVersion"
                    android:text="当前版本：检查中…"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <Button
                    android:id="@+id/btnCheckUpdate"
                    android:text="检测更新"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/tvUpdateMsg"
                    android:textSize="13sp"
                    android:textColor="@color/ok_text"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 卡片：修改密码 -->
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="修改密码"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <EditText
                    android:id="@+id/etOld"
                    android:hint="原密码"
                    android:inputType="textPassword"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <EditText
                    android:id="@+id/etNew"
                    android:hint="新密码（至少 6 位）"
                    android:inputType="textPassword"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <Button
                    android:id="@+id/btnChangePw"
                    android:text="修改密码"
                    android:textColor="@color/card"
                    android:background="@drawable/bg_btn_primary"
                    android:layout_marginTop="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/tvMsg"
                    android:textSize="13sp"
                    android:textColor="@color/danger"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 卡片：账号 -->
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="账号"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnLogout"
                    android:text="退出登录"
                    android:textColor="@color/danger"
                    android:background="@drawable/bg_btn"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvLogoutMsg"
                    android:textSize="13sp"
                    android:textColor="@color/danger"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <Space android:layout_width="match_parent" android:layout_height="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- 底部页签 -->
    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
