<?xml version="1.0" encoding="utf-8"?>
<!--
  底部页签：首页 / 定时任务 / 设置。
  各页面通过 <include layout="@layout/view_bottom_nav" /> 引入，选中态由 BottomNav.bind() 设置。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:background="@color/border"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/card"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/navHome"
            style="@style/NavItem">

            <ImageView
                android:id="@+id/navHomeIcon"
                android:src="@drawable/ic_nav_home"
                android:contentDescription="首页"
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:id="@+id/navHomeText"
                android:text="首页"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navJobs"
            style="@style/NavItem">

            <ImageView
                android:id="@+id/navJobsIcon"
                android:src="@drawable/ic_nav_jobs"
                android:contentDescription="定时任务"
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:id="@+id/navJobsText"
                android:text="定时任务"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            style="@style/NavItem">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:src="@drawable/ic_nav_settings"
                android:contentDescription="设置"
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:id="@+id/navSettingsText"
                android:text="设置"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
